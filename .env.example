# ========================================================
# NGUYỆT PHỐ B2B - FRONTEND ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Backend API Base URL (ASP.NET Core 8 Web API)
# Local development ports:
# - HTTP:  http://localhost:8089/api
# - HTTPS: https://localhost:7256/api
VITE_API_BASE_URL=http://localhost:8089/api
VITE_API_VERSION=v1
VITE_API_TIMEOUT=15000

# 2. Application Information
VITE_APP_NAME="Nguyệt Phố - Sàn Giao Dịch Bánh Trung Thu B2B Luxury"
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# 3. Feature Flags & Mocking
# Bật true để tự động fallback sang mock data khi backend API chưa khởi chạy
VITE_ENABLE_MOCK_FALLBACK=true
VITE_ENABLE_DEBUG_LOGS=true

# 4. Third-party Integrations
# Google OAuth 2.0 Client ID for Social Login
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Payment Gateway (VNPAY Sandbox)
VITE_VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
